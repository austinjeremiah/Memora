ENVIRONMENT=development
LOG_LEVEL=info

# Sibyl Memory store. The SDK works unactivated (verified against
# sibyl-memory-client 0.7.0); `sibyl init` is only needed for the
# server-side tier check and the demo's `sibyl status` screenshot.
SIBYL_DB_PATH=~/.sibyl-memory/memory.db

# LLM (Groq, OpenAI-compatible endpoint). Model id is confirmed against
# GET /v1/models with the real key before use — never hardcoded blind.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Base Sepolia (chainId 84532)
BASE_RPC_URL=https://sepolia.base.org
BASE_PRIVATE_KEY=
BASE_COMMITMENT_CONTRACT_ADDRESS=

MAX_EVIDENCE_ITEMS=8
GATE_STRICT_MODE=true
